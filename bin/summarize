#!/bin/bash
# Summarize a transcript using one of three backends.
#
#   none        - no summary, just transcription (cheapest)
#   local       - llama.cpp with a small GGUF model, fully offline
#   openrouter  - OpenRouter API, best quality, needs a key
#
# Author: Harsh Gandhi (harshgandhi.com) / Buho Smart Tools (buho.co.in)

source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

MODEL_CATALOG() {
  cat <<'EOF'
# id | gguf-repo/file | approx MB | fits 512MB Pi alongside pihole?
smollm2-135m-instruct-q4_k_m|barackhusain1/smollm2-135m-instruct-GGUF/smollm2-135m-instruct-Q4_K_M.gguf|105|yes (fastest, weakest)
gemma-3-270m-it-q4_k_m|unsloth/gemma-3-270m-it-GGUF/gemma-3-270m-it-Q4_K_M.gguf|253|yes (recommended)
smollm2-360m-instruct-q4_k_m|bartowski/SmolLM2-360M-Instruct-GGUF/SmolLM2-360M-Instruct-Q4_K_M.gguf|270|yes (tight)
smollm2-360m-instruct-q2_k|bartowski/SmolLM2-360M-Instruct-GGUF/SmolLM2-360M-Instruct-Q2_K.gguf|219|yes (very tight)
qwen3-0.6b-q4_k_m|unsloth/Qwen3-0.6B-GGUF/Qwen3-0.6B-Q4_K_M.gguf|397|no (needs swap)
qwen2.5-0.5b-instruct-q4_k_m|Qwen/Qwen2.5-0.5B-Instruct-GGUF/qwen2.5-0.5b-instruct-q4_k_m.gguf|491|no (needs swap)
EOF
}

model_path_for() {
  MODEL_CATALOG | awk -F'|' -v m="$1" '$1==m {print $2}'
}

model_size_for() {
  MODEL_CATALOG | awk -F'|' -v m="$1" '$1==m {print $3}'
}

download_model() {
  local id="$1" repo_file
  repo_file="$(model_path_for "$id")"
  if [ -z "$repo_file" ]; then
    log_error "unknown model id: $id"
    MODEL_CATALOG >&2
    return 1
  fi
  mkdir -p "$RP_MODEL_DIR"
  local out="$RP_MODEL_DIR/$(basename "$repo_file")"
  if [ -s "$out" ]; then
    log_info "model already present: $(basename "$out")"
    printf '%s' "$out"; return 0
  fi
  local url="https://huggingface.co/${repo_file}?download=true"
  log_info "downloading model $id (~$(model_size_for "$id")MB) -> $out"
  curl -sL --max-time 1800 --retry 3 --retry-delay 5 -C - \
       -o "$out.part" "$url" || { rm -f "$out.part"; return 1; }
  mv "$out.part" "$out"
  log_info "model ready: $(basename "$out")"
  printf '%s' "$out"
}

# Chunk a long transcript so the small context window still sees the whole thing.
split_chunks() {
  local file="$1" outdir="$2" chunk_words="${3:-1200}"
  mkdir -p "$outdir"
  tr -s '[:space:]' '\n' < "$file" | awk -v n="$chunk_words" '
    BEGIN{ i=1; c=1 }
    { words[i++]=$0; if (i>n) { f=sprintf(sprintf("%s/chunk-%03d.txt", "'"$outdir"'", c)); 
        for(j=1;j<=n;j++) print words[j] >> f; close(f); delete words; i=1; c++ } }
    END{ if (i>0) { f=sprintf(sprintf("%s/chunk-%03d.txt", "'"$outdir"'", c));
        for(j=1;j<i;j++) print words[j] >> f; close(f) } }
  '
  ls "$outdir"/chunk-*.txt 2>/dev/null | sort
}

PROMPT_HEAD='Below is a transcript of a video interview or talk. Summarise the main points as concise bullet points. Capture the guest'"'"'s key claims, any concrete figures or dates mentioned, and the overall conclusion. Do not invent details that are not in the text.

TRANSCRIPT:
'
PROMPT_TAIL='

Summary (5-8 bullet points, plain text):'

summarize_local() {
  local transcript="$1" model_path="$2"
  local llama="$RP_BIN/llama-cli"
  [ -x "$llama" ] || { log_error "llama-cli not found at $llama"; return 1; }
  local chunks_dir; chunks_dir="$(mktemp -d)"
  local chunk_summary chunk_final
  chunk_summary="$(mktemp)"
  mapfile -t chunks < <(split_chunks "$transcript" "$chunks_dir" "$(cfg llm_chunk_words 1200)")
  log_info "local summarizer: ${#chunks[@]} chunk(s), model $(basename "$model_path")"
  local first=1
  for c in "${chunks[@]}"; do
    local body; body="$(cat "$c")"
    local out
    out="$(printf '%s%s%s' "$PROMPT_HEAD" "$body" "$PROMPT_TAIL" \
      | "$llama" -m "$model_path" -n 220 -c 2048 -t "$(cfg llm_threads 2)" --temp 0.3 -no-cnv \
          -p "$(cat)" 2>/dev/null)" || out=""
    [ -z "$out" ] && out="(local summarizer produced no output for this section)"
    if [ "$first" -eq 1 ]; then
      printf '%s\n' "$out" > "$chunk_summary"
      first=0
    else
      printf '%s\n%s\n' "$chunk_summary" "$out" > "$chunk_summary.merge" && mv "$chunk_summary.merge" "$chunk_summary"
    fi
  done
  # Final consolidation pass over the per-chunk notes.
  chunk_final="$(cat "$chunk_summary")"
  local final
  final="$(printf '%s%s%s' "$PROMPT_HEAD" "$chunk_final" "$PROMPT_TAIL" \
    | "$llama" -m "$model_path" -n 260 -c 2048 -t "$(cfg llm_threads 2)" --temp 0.3 -no-cnv \
        -p "$(cat)" 2>/dev/null)"
  rm -rf "$chunks_dir"
  if [ -z "$final" ]; then
    printf '%s\n' "$chunk_final"
    return 0
  fi
  printf '%s\n' "$final"
}

# Remote summarisation via OpenRouter. Delegates to bin/openrouter, which
# discovers the free-tier model list, ranks it, and fails over automatically so
# a paid model can never be selected.
summarize_remote() {
  local transcript="$1"
  "$RP_BIN/openrouter" "$transcript"
}

# No-AI fallback: pick the most "summary-like" sentences using a cheap TF-based
# score (term frequency overlap with the whole transcript, length-normalised).
# No model, no RAM, no network - it just gives podcast apps something useful in
# the episode description instead of a placeholder.
extractive_summary() {
  local transcript="$1"
  local max_sentences; max_sentences="$(cfg extractive_sentences 7)"
  awk -v maxs="$max_sentences" '
    { gsub(/\r/, ""); print }
  ' "$transcript" |
  tr '\n' ' ' |
  sed -e 's/\. /\.\n/g' -e 's/? /?\n/g' -e 's/! /!\n/g' |
  awk -v maxs="$maxs" '
    { gsub(/^[ \t]+|[ \t]+$/, ""); if (length($0) > 40) print }
  ' > "$RP_ROOT/run/.ext.txt"

  # Document frequency over the candidate sentences.
  awk -v maxs="$maxs" '
    { for (i = 1; i <= NF; i++) { w = tolower($i); gsub(/[^a-z0-9]/, "", w);
        if (length(w) > 4) freq[w]++ } }
    END { for (w in freq) if (freq[w] > 2) df[w] = freq[w] }
  ' "$RP_ROOT/run/.ext.txt" > /dev/null

  awk -v maxs="$maxs" '
    { s = $0; n = split($0, words, " ");
      if (n < 6) next;
      score = 0; seen = 0;
      delete uniq;
      for (i = 1; i <= n; i++) {
        w = tolower(words[i]); gsub(/[^a-z0-9]/, "", w);
        if (length(w) > 4 && !(w in uniq)) { uniq[w] = 1; seen++ }
      }
      if (seen == 0) next;
      # prefer sentences containing numeric/specific detail
      bonus = (s ~ /[0-9]{2}/) ? 0.6 : 0;
      score = seen / sqrt(n) + bonus;
      printf "%d\t%s\n", score, s }
  ' "$RP_ROOT/run/.ext.txt" | sort -rn -k1,1 | head -"$max_sentences" | cut -f2- |
  tac | awk '{ printf "- %s\n", $0 }
    { }' | sed 's/-$/-/'
  rm -f "$RP_ROOT/run/.ext.txt"
}

# main: $1 = transcript path. Prints summary on stdout.
summarize() {
  local transcript="$1"
  local mode; mode="$(cfg summarize local)"
  case "$mode" in
    none)
      # Still produce a usable description without any model.
      extractive_summary "$transcript" ;;
    "")
      extractive_summary "$transcript" ;;
    openrouter)
      summarize_remote "$transcript" ;;
    extractive)
      extractive_summary "$transcript" ;;
    local|*)
      local model_path
      model_path="$RP_MODEL_DIR/$(basename "$(model_path_for "$(cfg model_local gemma-3-270m-it-q4_k_m)")")"
      if [ ! -s "$model_path" ]; then
        log_warn "local model not found, downloading $(cfg model_local)"
        model_path="$(download_model "$(cfg model_local gemma-3-270m-it-q4_k_m)")" || {
          log_error "local summarizer unavailable; falling back to none"
          printf 'Local summarizer unavailable.\n'; return 0; }
      fi
      summarize_local "$transcript" "$model_path" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  case "${1:-}" in
    --list-models) MODEL_CATALOG ;;
    --download)    download_model "${2:?model id required}" ;;
    *)             summarize "${1:?transcript path required}" ;;
  esac
fi
