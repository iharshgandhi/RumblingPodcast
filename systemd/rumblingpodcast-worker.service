[Unit]
Description=RumblingPodcast worker (discover, download, transcribe, summarize, publish)
Documentation=https://github.com/iharshgandhi/RumblingPodcast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the app owner, never root. Without this the worker creates
# root-owned lock/state files that block non-root runs and manual
# 'rp-ctl run-once'. Override with RP_USER=... if your install differs.
# RP_USER is substituted at install time by install.sh / rp-ctl upgrade.
User=__RP_USER__
Group=__RP_USER__
ExecStart=/opt/rumblingpodcast/bin/worker
Restart=always
RestartSec=30

# Be a good neighbour: Pi-hole's DNS resolution always wins.
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=batch

# Log to journal; the app also writes /opt/rumblingpodcast/logs/rp.log
StandardOutput=append:/opt/rumblingpodcast/logs/worker.out
StandardError=append:/opt/rumblingpodcast/logs/worker.err

[Install]
WantedBy=multi-user.target
